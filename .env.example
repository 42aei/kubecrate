# .env is operator-provided local input for bootstrap installation.
# Do not commit a real .env file with secrets.
# Seed Secrets are materialized from this local file into a Kubernetes Secret
# named `seed-secrets` in the External-Secrets Operator namespace.
# Services should consume service-specific Secrets projected by ESO, not the
# raw `seed-secrets` Secret.

# GitOps repository access for the Git credential projected into flux-system
# in the first-slice Flux path.
SEED_GIT_URL=https://github.com/example-org/example-repo.git
SEED_GIT_USERNAME=<git-username-or-token-name>
SEED_GIT_PASSWORD=<git-password-or-token>

# Optional SSH-style Git access if the first-slice Flux path uses it later.
SEED_GIT_SSH_PRIVATE_KEY=<ssh-private-key>
SEED_GIT_KNOWN_HOSTS=<known-hosts-entry>

# Example provider trust material placeholders for future ESO projections.
SEED_AWS_ACCESS_KEY_ID=<aws-access-key-id>
SEED_AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
SEED_GCP_SERVICE_ACCOUNT_JSON=<gcp-service-account-json>
SEED_VAULT_TOKEN=<vault-token>
