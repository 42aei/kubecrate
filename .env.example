# .env is the real operator-provided local input for bootstrap installation.
# .env.example is committed for documentation only. Do not commit a real .env.
# Bootstrap materializes `seed-secrets` from .env, for example:
# kubectl create secret generic seed-secrets -n eso --from-env-file=.env --dry-run=client -o yaml | kubectl apply -f -
# Flux HTTPS Git auth uses a Secret with `username` and `password` keys.
# Project SEED_FLUX_GIT_USERNAME into `username` and SEED_FLUX_GIT_PAT into `password`.
# The fine-grained PAT should have repository read access now and write access
# before Flux ImageUpdateAutomation is enabled.

SEED_FLUX_GIT_URL=https://github.com/<owner>/<repo>.git
SEED_FLUX_GIT_BRANCH=<implementation-branch>
SEED_FLUX_GIT_USERNAME=<github-username-or-bot-name>
SEED_FLUX_GIT_PAT=<fine-grained-pat-with-read-access-now-add-write-before-imageupdateautomation>
